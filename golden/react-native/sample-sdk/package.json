    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
