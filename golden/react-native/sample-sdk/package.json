{
  "name": "@devstrike/sample-sdk",
  "version": "0.1.0",
  "description": "React Native bindings for the sample_sdk native SDK, generated by Henosis.",
  "henosis": "Generated by Henosis 0.1.0. Do not edit.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "devstrike-sample-sdk-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "react-native.config.js",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @devstrike/sample-sdk-example",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "android",
    "henosis"
  ],
  "devDependencies": {
    "@react-native/babel-preset": "0.87.1",
    "@types/react": "^19.2.0",
